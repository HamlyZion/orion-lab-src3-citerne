        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_ssl_earliest_cert_expiry{job=\"blackbox\"} - time()",
          "legendFormat": "Validité restante du certificat TLS (s)",
          "refId": "B"
        }
      ]
    }
