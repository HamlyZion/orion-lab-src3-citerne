          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(0.995)",
          "legendFormat": "Objectif SLO (99,5 %)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
