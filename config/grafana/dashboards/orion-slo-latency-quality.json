        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traefik_service_requests_total{service=\"rag@file\", code!=\"429\"}[40s]))",
          "legendFormat": "Requêtes hors 429 sur 40 s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox\"}",
          "legendFormat": "Sonde HTTPS blackbox (1 = OK)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
