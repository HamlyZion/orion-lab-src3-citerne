      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Burn rate multi-fenêtres (8m / 40s) vs seuil critique 7,2 % (14,4x)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:traefik_errors:ratio_rate8m",
          "legendFormat": "Taux d'erreur 5xx (8m)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:traefik_errors:ratio_rate40s",
          "legendFormat": "Taux d'erreur 5xx (40s)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(0.072)",
          "legendFormat": "Seuil burn rate page (14,4 * 0,005 = 7,2 %)",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "SLO de latence p95 par backend (seuils : 12 s ollama, 2,5 s simule)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "Latence p95 {{backend}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(12)",
          "legendFormat": "SLO ollama (12 s)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(2.5)",
          "legendFormat": "SLO simule (2,5 s)",
          "refId": "C"
        }
      ]
    },
