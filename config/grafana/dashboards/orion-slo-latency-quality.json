      "title": "Fraîcheur de l'indexation du worker et validité du certificat TLS",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - worker_last_success_timestamp_seconds",
