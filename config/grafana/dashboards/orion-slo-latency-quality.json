      "id": 1,
      "title": "SLI de disponibilité Traefik (rag@file, hors 429) vs SLO 99,5 %",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (job:traefik_errors:ratio_rate8m or vector(0))",
